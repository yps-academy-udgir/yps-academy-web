{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalog-api",
      "urls": [
        "https://yps-backend-prod.onrender.com/api/classrooms",
        "https://yps-backend-prod.onrender.com/api/classrooms/**",
        "https://yps-backend-prod.onrender.com/api/students",
        "https://yps-backend-prod.onrender.com/api/students/**",
        "https://yps-backend-prod.onrender.com/api/faculty",
        "https://yps-backend-prod.onrender.com/api/faculty/**",
        "https://yps-backend-prod.onrender.com/api/attendance/**",
        "https://yps-backend-prod.onrender.com/api/exam-results/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "5s"
      }
    }
  ]
}
