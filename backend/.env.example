# YPS Academy Backend - Environment Configuration Template
# Copy this file to .env.dev or .env.prod and fill in the values
#
# For Local Development:
#   Copy to: .env
#   Use: Local MongoDB or MongoDB Atlas dev cluster
#
# For Production (main branch on Render):
#   Copy to: .env.prod
#   Use: MongoDB Atlas prod cluster

# Server Configuration
PORT=4026
NODE_ENV=development

# Database Configuration
# Local: mongodb://localhost:27017/yps-academy-dev
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/yps-academy-dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/yps-academy-dev

# Frontend Configuration (CORS)
# Local Development: http://localhost:4025
# Vercel Development: https://yps-academy-develop.vercel.app
# Vercel Production: https://yps-academy.vercel.app
FRONTEND_URL=http://localhost:4025
